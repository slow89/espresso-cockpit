{
  "name": "espresso-cockpit",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:browser:smoke",
    "deploy:tablet": "pnpm build && node scripts/deploy-tablet-skin.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:agent": "PLAYWRIGHT_AGENT_MODE=1 pnpm test:browser:smoke",
    "test:browser:full": "playwright test",
    "test:browser:real": "PLAYWRIGHT_REAL_GATEWAY_URL=${PLAYWRIGHT_REAL_GATEWAY_URL:-} playwright test tests/browser/real-gateway.spec.ts",
    "test:browser:smoke": "playwright test --project=tablet-sm-portrait --project=tablet-7-landscape --grep @smoke",
    "test:browser:update-snapshots": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@ai-sdk/provider": "^4.0.39",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "ai": "^7.0.181",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.10",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "ws": "^8.23.0"
  }
}
