{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "constraints": {
    "pnpm": "10"
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "One weekly PR for minor and patch updates. 0.x packages stay separate because their minors can break.",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "description": "The tablet WebView is about Chrome 91. Tailwind 4 needs Chrome 111+, and was already reverted once (5577357).",
      "matchPackageNames": ["tailwindcss"],
      "allowedVersions": "<4"
    },
    {
      "description": "Keep Node types on the current major until CI moves past Node 22.",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
